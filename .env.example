# LINE Developers Console > チャネル > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=

# LINE Developers Console > チャネル > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=

# Supabase Dashboard > Project Settings > API > service_role secret key（最重要機密。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console > API Keys（最重要機密。絶対に公開しない。NEXT_PUBLIC_にしないこと）
ANTHROPIC_API_KEY=

# エスカレーション通知の送信先LINEユーザーID（オーナー個人のLINE）。
# LINE Developers Console の「あなたのユーザーID」、またはオーナーが一度Botへメッセージを送信し
# conversations.raw_event の source.userId から確認して取得する。
OWNER_LINE_USER_ID=

# 管理画面(/admin)のログインパスワード（最重要機密。12文字以上、16文字以上のランダムな文字列を推奨。
# NEXT_PUBLIC_にしないこと）
ADMIN_PASSWORD=

# 管理画面のログイン状態(Cookie)の署名用シークレット（最重要機密。32文字以上のランダム文字列。
# 例: openssl rand -base64 32 。変更すると全員が再ログインになる。NEXT_PUBLIC_にしないこと）
ADMIN_SESSION_SECRET=

# Supabase一時停止対策のCron（/api/cron/keep-alive）の保護用シークレット（機密。16文字以上のランダム文字列。
# 例: openssl rand -base64 32 。Vercelの Production に登録すると、Vercel Cron が
# 「Authorization: Bearer <CRON_SECRET>」を付けて1日1回呼び出す。未設定・16文字未満だとCronは毎回失敗し、
# 7日間アクセスが無いとSupabase無料プランが一時停止される。前後に空白・改行を入れないこと。NEXT_PUBLIC_にしないこと）
CRON_SECRET=

# （任意）お客様ごとのAI回答の上限: 直近1時間に受信したテキストメッセージの件数。未設定なら10。
# 正の整数のみ有効（0・負数・小数などは警告を出して10を使う）。秘密情報ではない。
# 変更したら Vercel で再デプロイが必要。
RATE_LIMIT_MAX_PER_HOUR=

# （任意）お客様ごとのAI回答の上限: 直近24時間に受信したテキストメッセージの件数。未設定なら30。
# 正の整数のみ有効（不正な値は警告を出して30を使う）。秘密情報ではない。
# 変更したら Vercel で再デプロイが必要。
RATE_LIMIT_MAX_PER_DAY=
