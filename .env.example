# LINE Developers Console > チャネル > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=

# LINE Developers Console > チャネル > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=

# Supabase Dashboard > Project Settings > API > service_role secret key（最重要機密。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console > API Keys（最重要機密。絶対に公開しない。NEXT_PUBLIC_にしないこと）
ANTHROPIC_API_KEY=

# エスカレーション通知の送信先LINEユーザーID（オーナー個人のLINE）。
# LINE Developers Console の「あなたのユーザーID」、またはオーナーが一度Botへメッセージを送信し
# conversations.raw_event の source.userId から確認して取得する。
OWNER_LINE_USER_ID=

# 管理画面(/admin)のログインパスワード（最重要機密。12文字以上、16文字以上のランダムな文字列を推奨。
# NEXT_PUBLIC_にしないこと）
ADMIN_PASSWORD=

# 管理画面のログイン状態(Cookie)の署名用シークレット（最重要機密。32文字以上のランダム文字列。
# 例: openssl rand -base64 32 。変更すると全員が再ログインになる。NEXT_PUBLIC_にしないこと）
ADMIN_SESSION_SECRET=
